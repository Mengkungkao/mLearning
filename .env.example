# mLearning secrets. Copy to the data folder as ".env" (install.sh does this
# once, with owner-only permissions) and fill in what you use:
#   under mFruit OS:  ~/.whisplay-os/apps/mlearning/data/.env
#   on its own:       ~/.local/share/mlearning/.env
# Environment variables with the same names win over this file.
# Never commit a real key.

# OpenAI: speech recognition, the teacher's voice and (by default) the teacher.
OPENAI_API_KEY=
# Optional: an OpenAI-compatible server instead of api.openai.com.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic: only when Settings > Teacher AI is Claude (needs the anthropic
# Python package; see docs/CONFIGURATION.md).
ANTHROPIC_API_KEY=
